{
  "name": "dark-souls-save-organizer",
  "version": "1.0.2",
  "description": "An app to organize and backup dark souls saves",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:windows": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "smoke:linux": "electron . --smoke-test --no-sandbox"
  },
  "repository": "https://github.com/electron/electron-quick-start",
  "keywords": [
    "Dark",
    "Souls",
    "3",
    "III",
    "save"
  ],
  "author": "GitHub",
  "license": "CC0-1.0",
  "dependencies": {
    "angular": "^1.6.1",
    "angular-animate": "^1.6.1",
    "angular-aria": "^1.6.1",
    "angular-material": "^1.1.1",
    "angular-messages": "^1.6.1",
    "angular-route": "^1.6.1",
    "angular-sanitize": "1.6.1",
    "lodash": "^4.17.4"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.omgftw.dssm",
    "productName": "Dark Souls Save Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!test/**",
      "!docs/**",
      "!build/**",
      "!dist/**",
      "!*.md",
      "!gulpfile.js",
      "!build.windows.js",
      "!\\.github/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
